{
  "manifest_version": 3,
  "name": "AI Limit \u2014 Universal AI Usage HUD",
  "version": "1.0.0",
  "description": "Universal AI usage HUD for Chrome and Brave.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "AI Limit",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://github.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/provider-chatgpt.svg",
        "assets/icons/provider-gemini.svg",
        "assets/icons/provider-claude.svg",
        "assets/icons/provider-copilot.svg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://github.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/vendor/o200k_base.js",
        "src/content/chatgpt-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://github.com/*"
      ],
      "js": [
        "src/content/providers/detector-utils.js",
        "src/content/providers/chatgpt.js",
        "src/content/providers/claude.js",
        "src/content/providers/gemini.js",
        "src/content/providers/copilot.js",
        "src/content/provider-config.js",
        "src/content/usage-detector.js",
        "src/content/chatgpt-activity.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/hud/hud.css"
      ],
      "run_at": "document_idle"
    }
  ]
}